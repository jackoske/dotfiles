{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "gardener",
  "subagent_depth": 1,
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-luna-fast",
      "variant": "medium"
    },
    "scout": {
      "model": "openai/gpt-5.6-luna-fast",
      "variant": "medium"
    }
  },
  "plugin": [
    "opencode-usage-monitor@latest",
    "opencode-simple-notify@latest",
    "envsitter-guard@latest",
    "opencode-telemetry@latest"
  ]
}
